    "tiktok-live-connector": "2.5.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.19.1",
    "@types/ws": "^8.18.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
